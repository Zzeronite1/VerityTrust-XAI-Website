# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional. If set (or if GEMINI_API_KEY starts with "sk-or-"),
# requests are routed through OpenRouter instead of Google Gemini.
# OPENROUTER_API_KEY=""

# Optional: override the AI model failover order (comma-separated).
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash-lite,gemini-2.5-flash"
# OPENROUTER_MODELS="liquid/lfm-2.5-2.6b:free,openrouter/free"

# Optional: total time budget (ms) for the whole model failover chain. Default 20000.
# AI_TOTAL_BUDGET_MS=20000

# Optional: max AI-backed requests per IP per minute (0 = disabled). Default 30.
# RATE_LIMIT_PER_MIN=30

# Evidence engine (server/reputation.ts). Each source is downloaded in the background and cached in .cache/.
# GOOGLE_SAFE_BROWSING_API_KEY: optional, adds Google Safe Browsing lookups.
# GOOGLE_SAFE_BROWSING_API_KEY=""
# Set to "off" to disable a source (with all sources on, the server used ~285 MB RAM in testing).
# POPULARITY_LIST=off       # Tranco top-200k popularity ranking
# THREAT_FEEDS=off          # Phishing.Database + OpenPhish blacklists
# DOMAIN_AGE_LOOKUP=off     # RDAP domain registration date
# REPUTATION_CACHE_DIR=".cache/reputation"

# Deep-learning models (server/models/*.bin.gz). Retrain with:
#   npx tsx scripts/train-url-model.ts      (domain-name model, trained on Phishing.Database + Tranco)
#   npx tsx scripts/train-content-model.ts  (page-content model, trained on the knowledge-distilled corpus in scripts/content-corpus.ts)
# URL_MODEL=off
# CONTENT_MODEL=off
