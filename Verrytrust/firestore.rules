rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny All Fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'haihuyenak@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOrgOwner(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function getOrgRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function isOrgAdminOrOwner(orgId) {
      return isSystemAdmin() ||
        isOrgOwner(orgId) ||
        (isOrgMember(orgId) && (getOrgRole(orgId) == 'owner' || getOrgRole(orgId) == 'admin'));
    }

    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('currentOrgId' in data) || (data.currentOrgId is string && data.currentOrgId.size() <= 128));
    }

    // Organization validation
    function isValidOrganization(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500));
    }

    // Member validation
    function isValidOrgMember(data) {
      return data.keys().hasAll(['id', 'orgId', 'userId', 'email', 'role', 'joinedAt']) &&
        data.id is string && data.id.size() <= 256 &&
        data.orgId is string && data.orgId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (data.role in ['owner', 'admin', 'member', 'viewer']);
    }

    // Scan report validation
    function isValidScan(data) {
      return data.keys().hasAll(['id', 'userId', 'targetType', 'trustScore', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        (data.targetType in ['url', 'document', 'text', 'image']) &&
        (data.status in ['safe', 'caution', 'danger']) &&
        data.trustScore is number && data.trustScore >= 0 && data.trustScore <= 100 &&
        (!('targetTitle' in data) || (data.targetTitle is string && data.targetTitle.size() <= 500)) &&
        (!('targetValue' in data) || (data.targetValue is string && data.targetValue.size() <= 4000)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 4000)) &&
        (!('detailsJson' in data) || (data.detailsJson is string && data.detailsJson.size() <= 100000)) &&
        (!('orgId' in data) || (data.orgId is string && data.orgId.size() <= 128)) &&
        (!('isOrgShared' in data) || data.isOrgShared is bool) &&
        (!('isSensitive' in data) || data.isSensitive is bool);
    }

    // Audit log validation
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'orgId', 'userId', 'action', 'timestamp']) &&
        data.id is string && data.id.size() <= 128 &&
        data.orgId is string && data.orgId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.action is string && data.action.size() <= 128 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
        (!('resourceType' in data) || (data.resourceType is string && data.resourceType.size() <= 64)) &&
        (!('resourceId' in data) || (data.resourceId is string && data.resourceId.size() <= 128)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500));
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isUser(userId) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow create: if isUser(userId) && isValidUser(request.resource.data);
      allow update: if (isUser(userId) || isSystemAdmin()) && isValidUser(request.resource.data);
      allow delete: if isUser(userId) || isSystemAdmin();
    }

    // 2. Organizations collection
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (isOrgMember(orgId) || isOrgOwner(orgId) || isSystemAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orgId) && isValidOrganization(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isValidId(orgId) && isOrgAdminOrOwner(orgId) && isValidOrganization(request.resource.data);
      allow delete: if isValidId(orgId) && (isOrgOwner(orgId) || isSystemAdmin());

      // Organization Members subcollection
      match /members/{memberId} {
        allow get: if isValidId(memberId) && (isOrgMember(orgId) || isOrgOwner(orgId) || isSystemAdmin());
        allow list: if isOrgMember(orgId) || isOrgOwner(orgId) || isSystemAdmin();
        // Creator adds themselves as first member/owner, or org admin adds other members
        allow create: if isValidId(memberId) &&
          ((isOrgOwner(orgId) && request.resource.data.userId == request.auth.uid) || isOrgAdminOrOwner(orgId)) &&
          isValidOrgMember(request.resource.data);
        allow update: if isValidId(memberId) && isOrgAdminOrOwner(orgId) && isValidOrgMember(request.resource.data);
        allow delete: if isValidId(memberId) && (isOrgAdminOrOwner(orgId) || isUser(resource.data.userId));
      }

      // Organization Audit Logs subcollection
      match /audit_logs/{logId} {
        allow get, list: if isOrgAdminOrOwner(orgId);
        allow create: if isOrgMember(orgId) && isValidId(logId) && isValidAuditLog(request.resource.data);
        allow update, delete: if isSystemAdmin();
      }
    }

    // 3. Scans collection
    match /scans/{scanId} {
      allow get: if isValidId(scanId) && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid ||
        (
          resource.data.isOrgShared == true &&
          isOrgMember(resource.data.orgId) &&
          (resource.data.isSensitive == false || isOrgAdminOrOwner(resource.data.orgId))
        )
      );

      allow list: if isSignedIn() && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid ||
        (
          resource.data.isOrgShared == true &&
          isOrgMember(resource.data.orgId) &&
          (resource.data.isSensitive == false || isOrgAdminOrOwner(resource.data.orgId))
        )
      );

      allow create: if isSignedIn() && isValidId(scanId) && isValidScan(request.resource.data) && (
        !('orgId' in request.resource.data) ||
        request.resource.data.isOrgShared == false ||
        isOrgMember(request.resource.data.orgId)
      );

      allow update: if isValidId(scanId) && (
        isSystemAdmin() ||
        (resource.data.userId == request.auth.uid && isValidScan(request.resource.data))
      );

      allow delete: if isValidId(scanId) && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid ||
        ('orgId' in resource.data && isOrgAdminOrOwner(resource.data.orgId))
      );
    }
  }
}
